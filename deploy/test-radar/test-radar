#!/usr/bin/env bash
# Testinstanz von FriesenRadar: test-radar.devprops.de (installiert als /usr/local/bin/test-radar).
#
#   test-radar start         frische Datenkopie, Container hoch, Ende nach 2 h vormerken
#   test-radar stop          Container weg, Datenbank-Kopie und Konfiguration loeschen
#   test-radar status        Stand zeigen
#   test-radar aktualisieren laeuft sie gerade, mit dem neu gebauten Image neu starten
#   test-radar anforderung   Wunsch aus dem Admin der echten App abarbeiten (systemd-Pfadwaechter)
#
# Das Image `test-radar:aktuell` kommt vom Workflow test-image.yml (Zweig `test`).
#
# Was die Kopie NICHT kann, mit Absicht: Benachrichtigungen verschicken (Schluessel geleert,
# Abos geloescht), Telegram, KI-Abfragen, TeamSpeak. Der Zugang laeuft ueber ein Passwort in
# nginx (Benutzer admin, Admin-Passwort der App).
#
# Wer das Passwort kennt, ist in der Kopie zugleich als Mitglied angemeldet: Das Forum kennt
# die Testadresse nicht, also gibt nginx jeder Anfrage eine fuer diesen Lauf ausgestellte
# Sitzung mit (Name und CID aus /opt/test-radar/benutzer.env, nicht im Repo). So sieht die
# Testinstanz aus wie die echte App fuer ein angemeldetes Mitglied -- Name in der Kopfzeile,
# eigene Einstellungen.
set -euo pipefail

ORT=/opt/test-radar
PORT=8092
HTPASSWD=/etc/nginx/test-radar.htpasswd
ENDE_UNIT=test-radar-ende
SITZUNG=/etc/nginx/test-radar-sitzung.conf
LEEREN="VAPID_PRIVATE_KEY TELEGRAM_BOT_TOKEN TELEGRAM_CHAT_ID ANTHROPIC_API_KEY TS_QUERY_PASS"

# Die echte App: nach dem Umzug /opt/friesenradar, davor /opt/friesenspy.
if [ -f /opt/friesenradar/data/friesenradar.db ]; then
  PROD=/opt/friesenradar; PROD_DB=$PROD/data/friesenradar.db
else
  PROD=/opt/friesenspy;   PROD_DB=$PROD/data/friesenspy.db
fi
UEBERGABE=$PROD/data/testinstanz
compose=(docker compose --project-directory "$ORT" -f "$ORT/docker-compose.yml")

[ "$(id -u)" = 0 ] || { echo "als root ausfuehren" >&2; exit 1; }

laeuft() { [ -n "$(docker ps -q --filter name='^test-radar-test-radar-1$')" ]; }

stand_schreiben() {   # $1 true|false, $2 Meldung
  local seit="" bis="" version=""
  if [ "$1" = true ]; then
    seit=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    bis=$(date -u -d '+2 hours' +%Y-%m-%dT%H:%M:%SZ)
    version=$(docker exec test-radar-test-radar-1 python -c "from app.version import VERSION; print(VERSION)" 2>/dev/null || true)
  fi
  # Der Uebergabeordner gehoert dem Container. Alles darin geschieht deshalb als containersvc
  # und nie als root: Ein dort untergeschobener Symlink koennte root sonst eine beliebige
  # Datei ueberschreiben lassen.
  sudo -u containersvc mkdir -p "$UEBERGABE"
  sudo -u containersvc python3 - "$UEBERGABE/status.json" "$1" "$seit" "$bis" "$version" "${2:-}" <<'PY'
import json, sys
ziel, laeuft, seit, bis, version, meldung = sys.argv[1:7]
json.dump({"laeuft": laeuft == "true", "seit": seit or None, "bis": bis or None,
           "version": version or None, "meldung": meldung or None}, open(ziel, "w"))
PY
}

ende_abbestellen() {
  systemctl stop "$ENDE_UNIT.timer" 2>/dev/null || true
  systemctl reset-failed "$ENDE_UNIT.service" 2>/dev/null || true
}

abbruch_start() { echo "$*" >&2; rm -f "$ORT/config.env"; stand_schreiben false "Start gescheitert."; exit 1; }

starten() {
  if ! docker image inspect test-radar:aktuell >/dev/null 2>&1; then
    stand_schreiben false "Noch kein Stand gebaut (Zweig test)."; echo "kein Image test-radar:aktuell" >&2; exit 1
  fi
  [ -s "$PROD_DB" ] || { stand_schreiben false "Datenbank der echten App nicht gefunden."; exit 1; }
  "${compose[@]}" down 2>/dev/null || true

  # Daten: alles ausser Datenbank und Uebergabeordner; beim zweiten Mal nur die Unterschiede.
  # Der Ordner ist nur fuer root und den Container-Benutzer zugaenglich: Darin liegt eine
  # Kopie der Mitgliederdaten. Nie ueber /tmp -- dort waere sie fuer jeden Benutzer lesbar.
  mkdir -p "$ORT/data"
  chown root:containersvc "$ORT"; chmod 750 "$ORT"
  chown containersvc:containersvc "$ORT/data"; chmod 700 "$ORT/data"
  rm -f "$ORT"/data/radar.db*
  rsync -a --delete --exclude '*.db' --exclude '*.db-wal' --exclude '*.db-shm' \
        --exclude 'testinstanz' "$PROD/data/" "$ORT/data/"
  # Datenbank: nie per cp (WAL), immer .backup -- lesend, die echte App merkt nichts.
  chown containersvc:containersvc "$ORT/data"; chmod 700 "$ORT/data"
  ( umask 077
    sudo -u containersvc sqlite3 -readonly "$PROD_DB" ".backup '$ORT/data/radar.db'" )
  sudo -u containersvc sqlite3 "$ORT/data/radar.db" "DELETE FROM push_subscriptions;"
  chown -R containersvc:containersvc "$ORT/data"
  sudo -u containersvc chmod 600 "$ORT/data/radar.db"

  # Konfiguration: Kopie der echten, alles geleert, was nach aussen wirkt.
  install -m 600 -o root -g root "$PROD/config.env" "$ORT/config.env"
  for k in $LEEREN; do sed -i "s|^$k=.*|$k=|" "$ORT/config.env"; done
  sed -i "s|^TS_NOTIFY_ENABLED=.*|TS_NOTIFY_ENABLED=false|; s|^DB_PATH=.*|DB_PATH=/daten/radar.db|" "$ORT/config.env"
  grep -q '^DB_PATH=/daten/radar.db$' "$ORT/config.env" || echo 'DB_PATH=/daten/radar.db' >> "$ORT/config.env"
  # Eigene Schluessel je Lauf: Was die Kopie signiert (Sitzungen, Admin-Cookies), darf in der
  # echten App nichts gelten -- und umgekehrt. Der Forum-Schluessel wird ebenfalls ersetzt; er
  # muss nur vorhanden sein, damit die App den Login-Zwang wie in der Produktion zeigt.
  for k in SECRET_KEY SSO_SECRET; do
    grep -q "^$k=" "$ORT/config.env" || abbruch_start "$k fehlt in der Konfiguration"
    sed -i "s|^$k=.*|$k=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')|" "$ORT/config.env"
  done
  ! cmp -s <(grep '^SECRET_KEY=' "$PROD/config.env") <(grep '^SECRET_KEY=' "$ORT/config.env") \
    || abbruch_start "SECRET_KEY der Kopie gleicht dem der echten App"
  for k in VAPID_PRIVATE_KEY TELEGRAM_BOT_TOKEN ANTHROPIC_API_KEY; do
    ! grep -q "^$k=." "$ORT/config.env" || { echo "$k nicht geleert" >&2; exit 1; }
  done

  # Zugang: Benutzer admin, Admin-Passwort der App. Das Passwort geht per Pipe an htpasswd
  # und erscheint nirgends in einer Ausgabe oder Befehlszeile.
  grep '^ADMIN_PASSWORD=' "$PROD/config.env" | head -1 | cut -d= -f2- | tr -d '\n' \
    | htpasswd -Bic "$HTPASSWD" admin 2>/dev/null
  chown root:www-data "$HTPASSWD"; chmod 640 "$HTPASSWD"

  # Das Ende ZUERST vormerken: Was danach auch scheitert, die Instanz beendet sich nach 2 h.
  ende_abbestellen
  systemd-run --quiet --unit="$ENDE_UNIT" --on-active=2h /usr/local/bin/test-radar stop
  "${compose[@]}" up -d
  for i in $(seq 1 24); do
    sleep 5
    curl -sf "http://127.0.0.1:$PORT/health" | grep -q '"ok"' && break
    [ "$i" -lt 24 ] || { "${compose[@]}" logs --tail 30; stoppen; stand_schreiben false "Start gescheitert."; exit 1; }
  done

  sitzung_ausstellen || echo "Sitzung nicht ausgestellt -- Anmeldung in der Kopie geht dann nicht" >&2
  stand_schreiben true ""
  echo "Testinstanz laeuft: https://test-radar.devprops.de (endet in 2 h)"
}

sitzung_ausstellen() {
  # Sitzung fuer diesen Lauf (2 h + 5 min), signiert mit dem Schluessel der Kopie. nginx haengt
  # sie an jede Anfrage; ohne benutzer.env bleibt es beim Forum-Login (der hier nicht geht).
  : > "$SITZUNG"
  if [ -f "$ORT/benutzer.env" ]; then
    local marke
    marke=$(docker exec -i --env-file "$ORT/benutzer.env" test-radar-test-radar-1 python -c "
import os, time
from app.config import get_settings
from app.forum_sso import make_user_token
print(make_user_token(get_settings().SECRET_KEY, os.environ['TEST_NAME'], os.environ['TEST_CID'], True, time.time() + 7500))")
    case "$marke" in
      *[!A-Za-z0-9._=-]*|"") echo "Sitzung nicht ausgestellt" >&2 ;;
      *) printf 'proxy_set_header Cookie "fs_user=%s; $http_cookie";\n' "$marke" > "$SITZUNG" ;;
    esac
  fi
  chown root:root "$SITZUNG"; chmod 600 "$SITZUNG"
  nginx -t 2>/dev/null && systemctl reload nginx
}

stoppen() {
  : > "$SITZUNG"; nginx -t 2>/dev/null && systemctl reload nginx
  "${compose[@]}" down 2>/dev/null || true
  rm -f "$ORT"/data/radar.db* "$ORT/config.env"
  ende_abbestellen
  stand_schreiben false ""
  echo "Testinstanz beendet."
}

case "${1:-}" in
  start)  starten ;;
  stop)   stoppen ;;
  status) if laeuft; then echo "laeuft"; else echo "aus"; fi; cat "$UEBERGABE/status.json" 2>/dev/null; echo ;;
  aktualisieren)
    # Neues Image gebaut: Nur wenn sie gerade laeuft, mit denselben Daten neu starten.
    if laeuft; then "${compose[@]}" up -d; echo "Testinstanz auf neuen Stand gebracht."; fi ;;
  anforderung)
    # Die Datei schreibt die echte App (Container). Ihr Inhalt wird NUR verglichen, nie
    # ausgefuehrt -- und zuerst geloescht, damit der Pfadwaechter nicht in Schleife laeuft.
    datei="$UEBERGABE/anforderung"
    wunsch=$(sudo -u containersvc head -c 16 "$datei" 2>/dev/null | tr -cd 'a-z' || true)
    sudo -u containersvc rm -f "$datei"
    case "$wunsch" in
      start|stop) exec /usr/local/bin/test-radar "$wunsch" ;;
      *) echo "unbekannte Anforderung verworfen" >&2 ;;
    esac ;;
  *) echo "Aufruf: test-radar start|stop|status|aktualisieren" >&2; exit 2 ;;
esac
